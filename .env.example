# Copie este arquivo para ".env" e ajuste os valores.
#   cp .env.example .env

# Senha do painel /admin  (OBRIGATORIA - troque!)
ADMIN_SENHA=troque-esta-senha

# Segredo para assinar o cookie de sessao. Se deixar vazio, e derivado da senha.
# Para gerar um: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSAO_SEGREDO=

# Porta que voce vai acessar no navegador: http://localhost:8099
# (a 8080 costuma estar ocupada por outros containers)
PORTA_HOST=8099

# Nome que aparece no topo do catalogo
TITULO=Central de Jogos

# Quantas horas o login continua valendo
SESSAO_HORAS=12

# Limites de upload (o tmpfs do compose e de 512 MB - nao passe disso no MAX_ZIP_MB)
MAX_ZIP_MB=200
MAX_DESCOMPACTADO_MB=600

TZ=America/Sao_Paulo
